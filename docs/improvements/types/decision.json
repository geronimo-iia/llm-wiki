{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geronimo-iia/llm-wiki/schemas/v0.1.0/decision.json",
  "title": "Decision type",
  "description": "Recorded choice with governance metadata — effective date, accountable owner, and rationale links.",
  "type": "object",
  "required": ["title", "type"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name"
    },
    "type": {
      "type": "string",
      "x-keyword": true,
      "description": "Page type from registry"
    },
    "summary": {
      "type": "string",
      "description": "One-line scope"
    },
    "status": {
      "type": "string",
      "description": "Lifecycle state",
      "enum": ["active", "draft", "stub", "generated"]
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 date"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "x-keyword": true,
      "description": "Lowercase hyphenated search terms"
    },
    "owner": {
      "type": "string",
      "description": "Person, team, or agent responsible"
    },
    "superseded_by": {
      "type": "string",
      "description": "Slug of replacement page"
    },
    "superseded_on": {
      "type": "string",
      "description": "ISO 8601 date when this decision was superseded"
    },
    "effective_date": {
      "type": "string",
      "description": "ISO 8601 date when the decision came into force"
    },
    "accountable_owner": {
      "type": "string",
      "description": "Person or team responsible if the decision is challenged"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Slugs of source pages that carry the rationale or evidence"
    }
  },
  "x-wiki-types": {
    "decision": "Recorded choice with governance metadata — effective date, accountable owner, and rationale links"
  },
  "x-graph-edges": {
    "sources": {
      "relation": "informed-by",
      "direction": "outgoing",
      "target_types": ["paper", "article", "documentation", "clipping", "transcript", "note", "data", "book-chapter", "thread"]
    },
    "superseded_by": {
      "relation": "superseded-by",
      "direction": "outgoing"
    }
  },
  "additionalProperties": true
}
